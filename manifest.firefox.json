{
  "manifest_version": 3,
  "name": "Page Smash",
  "version": "1.0.0",
  "description": "Smash any webpage apart with a jetpack and five weapons. Original toy, not affiliated with Page Rage.",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-smash@mrzroot.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "action": {
    "default_title": "Smash this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["vendor/matter.min.js", "game.js"],
    "css": ["game.css"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
